# College AI - Environment Variables
# Copy this file to .env and fill in your API keys

# Groq API (Recommended - Free tier available, fast inference)
# Get key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (Optional - if using GPT models)
# Get key from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API (Optional - if using Gemini models)
# Get key from: https://makersuite.google.com/
# GOOGLE_API_KEY=your_google_api_key_here

# Other configurations (optional)
# LOG_LEVEL=INFO
# FAISS_STORE_DIR=./data/faiss_store
